<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret" Width="920" Height="660" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="#E6E8EE" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#3DDC97"/>
    <SolidColorBrush x:Key="Card" Color="#1A1D24"/>
    <SolidColorBrush x:Key="Field" Color="#22262F"/>
    <SolidColorBrush x:Key="Line" Color="#2E3340"/>
    <SolidColorBrush x:Key="Muted" Color="#8A90A0"/>

    <!-- ===== пиксельный стиль ===== -->
    <FontFamily x:Key="Px">PXFONT</FontFamily>
    <Style x:Key="PxText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Px}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
    </Style>
    <!-- пиксельные значки (клетка 2 px) -->
    <Geometry x:Key="PxX">M0,0h2v2h-2z M2,2h2v2h-2z M4,4h2v2h-2z M6,6h2v2h-2z M8,8h2v2h-2z M8,0h2v2h-2z M6,2h2v2h-2z M2,6h2v2h-2z M0,8h2v2h-2z</Geometry>
    <Geometry x:Key="PxMin">M0,8h10v2h-10z</Geometry>
    <Geometry x:Key="PxChat">M1,2h14v9h-8v2h-2v2h-2v-4h-2z M4,6h2v2h-2z M7,6h2v2h-2z M10,6h2v2h-2z</Geometry>
    <Geometry x:Key="PxGear">M4,0h2v2h2v-2h2v2h2v2h-2v2h2v2h2v2h-2v2h-2v2h2v2h-2v-2h-2v2h-2v-2h-2v2h-2v-2h2v-2h-2v-2h-2v-2h2v-2h2v-2h-2v-2h2z M6,6v4h4v-4z</Geometry>
    <Geometry x:Key="PxTick">M0,4h2v2h-2z M2,6h2v2h-2z M4,4h2v2h-2z M6,2h2v2h-2z M8,0h2v2h-2z</Geometry>
    <Geometry x:Key="PxDown">M0,0h10v2h-2v2h-2v2h-2v-2h-2v-2h-2z</Geometry>
    <Geometry x:Key="PxCollapse">M0,0h2v2h2v2h2v2h-2v2h-2v2h-2z M6,0h2v2h2v2h2v2h-2v2h-2v2h-2z</Geometry>
    <Geometry x:Key="PxRight">M0,0h2v2h2v2h2v2h-2v2h-2v2h-2z</Geometry>

    <!-- кнопка: квадратная, рамка 2 px, жёсткая тень; при нажатии «вдавливается» в тень -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Background" Value="#22262F"/>
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Sh" Background="#08090B" Margin="3,3,0,0"/>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" Margin="0,0,3,3" Padding="{TemplateBinding Padding}" BorderBrush="#2E3340" BorderThickness="2">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3DDC97"/>
                <Setter TargetName="Bd" Property="Background" Value="#2A2E38"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3DDC97"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard>
                    <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Margin">
                      <DiscreteThicknessKeyFrame KeyTime="0:0:0" Value="1,1,2,2"/>
                      <DiscreteThicknessKeyFrame KeyTime="0:0:0.03" Value="3,3,0,0"/>
                    </ThicknessAnimationUsingKeyFrames>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard>
                    <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Margin">
                      <DiscreteThicknessKeyFrame KeyTime="0:0:0" Value="1,1,2,2"/>
                      <DiscreteThicknessKeyFrame KeyTime="0:0:0.04" Value="0,0,3,3"/>
                    </ThicknessAnimationUsingKeyFrames>
                  </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#3DDC97"/>
      <Setter Property="Foreground" Value="#0F1115"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Sh" Background="#1B5E42" Margin="3,3,0,0"/>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" Margin="0,0,3,3" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding Background}" BorderThickness="2">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#7FE8B8"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E6E8EE"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard>
                    <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Margin">
                      <DiscreteThicknessKeyFrame KeyTime="0:0:0" Value="1,1,2,2"/>
                      <DiscreteThicknessKeyFrame KeyTime="0:0:0.03" Value="3,3,0,0"/>
                    </ThicknessAnimationUsingKeyFrames>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard>
                    <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Margin">
                      <DiscreteThicknessKeyFrame KeyTime="0:0:0" Value="1,1,2,2"/>
                      <DiscreteThicknessKeyFrame KeyTime="0:0:0.04" Value="0,0,3,3"/>
                    </ThicknessAnimationUsingKeyFrames>
                  </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleBtn" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#8A90A0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" Width="34" Height="28">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A2E38"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E2129"/>
                <Setter Property="Foreground" Value="#3DDC97"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="10,7" Margin="2,0">
              <DockPanel>
                <Path x:Name="Mk" Data="{StaticResource PxRight}" Fill="#3DDC97" Width="6" Height="10" Stretch="None" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Hidden" SnapsToDevicePixels="True"/>
                <ContentPresenter/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A2E38"/>
                <Setter TargetName="Mk" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#3DDC97"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border Background="#08090B" Margin="3,3,0,0"/>
              <ToggleButton Focusable="False" ClickMode="Press" Margin="0,0,3,3"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="#1A1D24" BorderBrush="#2E3340" BorderThickness="2">
                      <Path x:Name="Arr" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                            Data="{StaticResource PxDown}" Fill="#8A90A0" SnapsToDevicePixels="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3DDC97"/>
                        <Setter TargetName="Arr" Property="Fill" Value="#3DDC97"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                Margin="14,0,38,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="None">
                <Grid x:Name="DropBox" Margin="0,2,6,6" MinWidth="{TemplateBinding ActualWidth}" RenderTransformOrigin="0.5,0">
                  <Grid.RenderTransform><ScaleTransform x:Name="DropScale" ScaleY="1"/></Grid.RenderTransform>
                  <Border Background="#08090B" Margin="4,4,-4,-4"/>
                  <Border Background="#1A1D24" BorderBrush="#3DDC97" BorderThickness="2" MaxHeight="320" Padding="0,4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DropScale" Storyboard.TargetProperty="ScaleY">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.4"/>
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.035" Value="0.75"/>
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.07" Value="1"/>
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DropBox" Storyboard.TargetProperty="Opacity">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.07" Value="1"/>
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- переключатель: квадратный трек и квадратный ползунок, двигается рывками по 7 px -->
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="44" Height="24" Background="#2E3340" BorderBrush="#08090B" BorderThickness="0,0,2,2">
              <Rectangle x:Name="Knob" Width="14" Height="14" Fill="#E6E8EE" HorizontalAlignment="Left" Margin="4,0,0,0">
                <Rectangle.RenderTransform><TranslateTransform x:Name="KnobT" X="0"/></Rectangle.RenderTransform>
              </Rectangle>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="8"/>
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="16"/>
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="22"/>
                    </DoubleAnimationUsingKeyFrames>
                    <ColorAnimationUsingKeyFrames Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                      <DiscreteColorKeyFrame KeyTime="0:0:0.08" Value="#3DDC97"/>
                    </ColorAnimationUsingKeyFrames>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="14"/>
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="6"/>
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="0"/>
                    </DoubleAnimationUsingKeyFrames>
                    <ColorAnimationUsingKeyFrames Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                      <DiscreteColorKeyFrame KeyTime="0:0:0.08" Value="#2E3340"/>
                    </ColorAnimationUsingKeyFrames>
                  </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PickRow" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#9AA3B5"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="#1E2129" BorderBrush="#262A33" BorderThickness="2" Padding="9,6" Margin="0,0,6,6">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="Box" Width="16" Height="16" BorderBrush="#3A3F4D" BorderThickness="2" Background="#00000000" Margin="0,0,9,0" VerticalAlignment="Center">
                  <Path x:Name="Tick" Data="{StaticResource PxTick}" Fill="#0F1115" Width="10" Height="8" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" SnapsToDevicePixels="True"/>
                </Border>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#22262F"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2D5A47"/>
                <Setter TargetName="Box" Property="Background" Value="#3DDC97"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#3DDC97"/>
                <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="#E6E8EE"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#9AA3B5"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="#22262F" BorderBrush="#2E3340" BorderThickness="2" Padding="12,5">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#5A6070"/>
                <Setter Property="Foreground" Value="#E6E8EE"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3DDC97"/>
                <Setter TargetName="Bd" Property="Background" Value="#1B3329"/>
                <Setter Property="Foreground" Value="#E6E8EE"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#9AA3B5"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="GroupName" Value="SetNav"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" Padding="12,9">
              <Grid>
                <Border x:Name="Ind" Width="4" Background="#3DDC97" HorizontalAlignment="Left" Margin="-12,0,0,0" Opacity="0"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1E2129"/>
                <Setter TargetName="Ind" Property="Opacity" Value="0.35"/>
                <Setter Property="Foreground" Value="#C9CED8"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#22262F"/>
                <Setter TargetName="Ind" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="#E6E8EE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SetCard" TargetType="Border">
      <Setter Property="Background" Value="#1E2129"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="BorderBrush" Value="#262A33"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style x:Key="RowBtn" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="#08090B" Margin="3,3,0,0"/>
              <Border x:Name="Bd" Background="#1E2129" Padding="14,10" Margin="0,0,3,3" BorderBrush="#262A33" BorderThickness="2">
                <DockPanel>
                  <Path x:Name="Chev" DockPanel.Dock="Right" Data="{StaticResource PxRight}" Fill="#5A6070" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                  <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </DockPanel>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3DDC97"/>
                <Setter TargetName="Bd" Property="Background" Value="#22262F"/>
                <Setter TargetName="Chev" Property="Fill" Value="#3DDC97"/>
                <Setter TargetName="Chev" Property="RenderTransform"><Setter.Value><TranslateTransform X="2"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Margin" Value="3,3,0,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Border x:Name="Box" BorderBrush="#3A3F4D" BorderThickness="2" Background="Transparent"/>
                <Path x:Name="Mark" Data="{StaticResource PxTick}" Fill="#0F1115" Width="10" Height="8" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" SnapsToDevicePixels="True"/>
                <Rectangle x:Name="Dash" Width="8" Height="2" Fill="#E6E8EE" Visibility="Hidden"/>
              </Grid>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#3DDC97"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#3DDC97"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#3DDC97"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Box" Property="Background" Value="#2D5A47"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#3DDC97"/>
                <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DelBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#8A90A0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" Width="26" Height="26">
              <Path Data="{StaticResource PxX}" Fill="{TemplateBinding Foreground}" Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3A2328"/>
                <Setter Property="Foreground" Value="#FF6B81"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Th" Background="#3A3F4D"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Th" Property="Background" Value="#5A6070"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Th" Property="Background" Value="#3DDC97"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid x:Name="Shell" Opacity="0">
    <Grid.RenderTransform><TranslateTransform x:Name="ShellShift" Y="18"/></Grid.RenderTransform>
    <!-- тень окна отдельно от содержимого: анимации внутри не заставляют её перерисовываться -->
    <Border x:Name="ShellShadow" Background="#000000" Opacity="0.5" Margin="6,6,-6,-6" IsHitTestVisible="False"/>
    <Border x:Name="ShellBody" BorderBrush="#252933" BorderThickness="2">
      <Border.Background>
        <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Stretch="None" RenderOptions.CachingHint="Cache">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Brush="#121419" Geometry="M0,0 H4 V4 H0 Z"/>
              <GeometryDrawing Brush="#15171D" Geometry="M0,3 H4 V4 H0 Z"/>
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </Border.Background>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" Margin="20,0,10,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- логотип приложения с точкой состояния (зелёная — zapret работает) -->
            <Grid Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
              <Image x:Name="TitleLogo" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
              <Rectangle x:Name="TitleDot" Width="8" Height="8" Fill="#5A6070" Stroke="#121419" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
            </Grid>
            <TextBlock Text="ZAPRET" Style="{StaticResource PxText}" FontSize="22.22" VerticalAlignment="Center" Margin="0,0,0,2"/>
            <TextBlock x:Name="TitleVer" Text="" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="ChatBtn" Style="{StaticResource TitleBtn}" Margin="0,0,4,0" ToolTip="Чат с разработчиком">
              <Grid>
                <Path Data="{StaticResource PxChat}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="None" SnapsToDevicePixels="True"/>
                <Rectangle x:Name="ChatDot" Width="8" Height="8" Fill="#3DDC97" Stroke="#121419" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0" Visibility="Collapsed"/>
              </Grid>
            </Button>
            <Button x:Name="GearBtn" Style="{StaticResource TitleBtn}" Margin="0,0,4,0" ToolTip="Настройки">
              <Path Data="{StaticResource PxGear}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="None" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                <Path.RenderTransform><RotateTransform x:Name="GearRot"/></Path.RenderTransform>
              </Path>
            </Button>
            <Button x:Name="MinBtn" Style="{StaticResource TitleBtn}" ToolTip="Свернуть"><Path Data="{StaticResource PxMin}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
            <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" Margin="4,0,0,0"><Path Data="{StaticResource PxX}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
          </StackPanel>
        </Grid>

        <Grid x:Name="MainArea" Grid.Row="1" Margin="22,4,22,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColDef" Width="330"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition x:Name="RightColDef" Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Левая колонка (когда «Мои сайты» свёрнуты — стоит по центру) -->
          <Grid x:Name="LeftCol" Grid.Column="0" Width="330" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- когда «Мои сайты» свёрнуты, стратегия, Telegram и тест встают справа от кнопки (колонка 2) -->
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="LcA" Width="*"/>
              <ColumnDefinition x:Name="LcGap" Width="0"/>
              <ColumnDefinition x:Name="LcB" Width="0"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="SideStack" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center">
              <StackPanel.RenderTransform><TranslateTransform x:Name="SideStackT"/></StackPanel.RenderTransform>
            </StackPanel>
            <StackPanel x:Name="CenterStack" VerticalAlignment="Center">
              <StackPanel.RenderTransform><TranslateTransform x:Name="CenterStackT"/></StackPanel.RenderTransform>
              <Button x:Name="PowerBtn" Width="200" Height="200" Cursor="Hand" HorizontalAlignment="Center" Focusable="False">
                <Button.Template>
                  <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                </Button.Template>
                <Grid x:Name="PowerGrid" Width="200" Height="200" RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True">
                  <Grid.RenderTransform><TranslateTransform x:Name="PowerLift"/></Grid.RenderTransform>
                  <!-- по прозрачным щелям между «пикселями» тоже можно нажать -->
                  <Ellipse Width="196" Height="196" Fill="Transparent"/>
                  <!-- пиксельные волны вокруг кнопки, кадры задаются в коде -->
                  <Grid Margin="-30" IsHitTestVisible="False">
                    <Path x:Name="Glow1" Fill="#3DDC97" Opacity="0"/>
                    <Path x:Name="Glow2" Fill="#3DDC97" Opacity="0"/>
                  </Grid>
                  <Path x:Name="PxOut"><Path.Fill><SolidColorBrush x:Name="PxOutB" Color="#2E3340"/></Path.Fill></Path>
                  <Path x:Name="PxDark"><Path.Fill><SolidColorBrush x:Name="PxDarkB" Color="#1E2129"/></Path.Fill></Path>
                  <Path x:Name="PxDisc"><Path.Fill><SolidColorBrush x:Name="PowerFill" Color="#262A33"/></Path.Fill></Path>
                  <Path x:Name="PxRim"><Path.Fill><SolidColorBrush x:Name="PxRimB" Color="#2E3340"/></Path.Fill></Path>
                  <Path x:Name="Spinner" Fill="#3DDC97" Opacity="0"/>
                  <Grid x:Name="IconWrap" Width="66" Height="60" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform x:Name="PowerIconScale"/>
                        <RotateTransform x:Name="PowerIconRot"/>
                      </TransformGroup>
                    </Grid.RenderTransform>
                    <Path Data="M12,6h6v6h-6z M48,6h6v6h-6z M6,12h6v6h-6z M54,12h6v6h-6z M0,18h6v6h-6z M60,18h6v6h-6z M0,24h6v6h-6z M60,24h6v6h-6z M0,30h6v6h-6z M60,30h6v6h-6z M0,36h6v6h-6z M60,36h6v6h-6z M6,42h6v6h-6z M54,42h6v6h-6z M12,48h6v6h-6z M48,48h6v6h-6z M18,54h30v6h-30z">
                      <Path.Fill><SolidColorBrush x:Name="IconBrush" Color="#8A90A0"/></Path.Fill>
                    </Path>
                    <Path Data="M30,0h6v6h-6z M30,6h6v6h-6z M30,12h6v6h-6z M30,18h6v6h-6z M30,24h6v6h-6z">
                      <Path.Fill><SolidColorBrush x:Name="IconBrush2" Color="#8A90A0"/></Path.Fill>
                    </Path>
                  </Grid>
                  <!-- слой эффектов анимаций включения (пиксели, молнии, волны) -->
                  <Canvas x:Name="FxLayer" Margin="-30" IsHitTestVisible="False" Panel.ZIndex="10"/>
                  <Grid x:Name="ZWrap" Width="88" Height="88" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Grid.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform x:Name="ZScale" ScaleX="0.3" ScaleY="0.3"/>
                        <ScaleTransform x:Name="ZFlip"/>
                        <RotateTransform x:Name="ZTilt"/>
                        <TranslateTransform x:Name="ZMove"/>
                      </TransformGroup>
                    </Grid.RenderTransform>
                    <Canvas Width="88" Height="88">
                      <Path x:Name="ZFill" Data="M0,0h88v8h-88z M0,8h88v8h-88z M56,16h24v8h-24z M48,24h24v8h-24z M40,32h24v8h-24z M32,40h24v8h-24z M24,48h24v8h-24z M16,56h24v8h-24z M8,64h24v8h-24z M0,72h88v8h-88z M0,80h88v8h-88z">
                        <Path.Fill><SolidColorBrush x:Name="ZBrush" Color="#3DDC97"/></Path.Fill>
                      </Path>
                      <!-- «змейка» из пикселей по букве Z при запуске (кадры задаются в коде) -->
                      <Path x:Name="ZDraw" Opacity="0">
                        <Path.Fill><SolidColorBrush x:Name="ZStroke" Color="#E6E8EE"/></Path.Fill>
                      </Path>
                      <!-- пиксельный блик, ступеньками пробегающий по букве -->
                      <Canvas Width="88" Height="88" IsHitTestVisible="False">
                        <Canvas.Clip><PathGeometry Figures="M0,0h88v8h-88z M0,8h88v8h-88z M56,16h24v8h-24z M48,24h24v8h-24z M40,32h24v8h-24z M32,40h24v8h-24z M24,48h24v8h-24z M16,56h24v8h-24z M8,64h24v8h-24z M0,72h88v8h-88z M0,80h88v8h-88z"/></Canvas.Clip>
                        <Path x:Name="ZShine" Fill="#FFFFFF" Opacity="0.5">
                          <Path.RenderTransform><TranslateTransform x:Name="ZShineT" X="-104"/></Path.RenderTransform>
                        </Path>
                      </Canvas>
                    </Canvas>
                  </Grid>
                </Grid>
              </Button>

              <TextBlock x:Name="StatusText" Text="Выключен" Style="{StaticResource PxText}" FontSize="33.33" HorizontalAlignment="Center" Margin="0,10,0,0"/>
              <TextBlock x:Name="SubText" Text="Нажми, чтобы включить" Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"/>

              <StackPanel x:Name="ControlsBlock">
              <TextBlock Text="Стратегия" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,26,0,6"/>
              <ComboBox x:Name="StrategyBox"/>

              <!-- Telegram (tg-ws-proxy): второй модуль Zapret, со своей кнопкой включения -->
              <Border x:Name="TgCard" Background="#1A1D24" Padding="14,12" Margin="0,16,0,0" BorderBrush="#232731" BorderThickness="2" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="TgPower" Width="56" Height="56" Cursor="Hand" Focusable="False" Margin="0,0,14,0" ToolTip="Включить или выключить Telegram-прокси">
                      <Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
                      <Grid Width="56" Height="56" RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True">
                        <Grid.RenderTransform><TranslateTransform x:Name="TgLift"/></Grid.RenderTransform>
                        <Rectangle Fill="Transparent"/>
                        <Grid Margin="-12" IsHitTestVisible="False">
                          <Path x:Name="TgGlow" Fill="#5ED3F3" Opacity="0"/>
                        </Grid>
                        <Path x:Name="TgDot"/>
                        <TextBlock x:Name="TgPlane" Visibility="Collapsed"/>
                        <Grid ClipToBounds="True" Margin="4">
                          <Canvas Width="33" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,2,0,0">
                            <Canvas.RenderTransform><TranslateTransform x:Name="TgPlaneT"/></Canvas.RenderTransform>
                            <Path x:Name="TgPlaneFill" Data="M27,0h6v3h-6z M21,3h12v3h-12z M15,6h15v3h-15z M9,9h21v3h-21z M3,12h21v3h-21z M9,15h18v3h-18z M15,18h9v3h-9z M15,21h3v3h-3z M21,21h3v3h-3z M15,24h3v3h-3z"/>
                            <Path x:Name="TgPlaneFold" Data="M30,0h3v3h-3z M24,3h6v3h-6z M18,6h6v3h-6z M12,9h6v3h-6z"/>
                            <Path x:Name="TgPlaneDraw" Opacity="0"/>
                          </Canvas>
                        </Grid>
                      </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <DockPanel>
                        <CheckBox x:Name="TgToggle" DockPanel.Dock="Right" Visibility="Collapsed"/>
                        <TextBlock Text="Telegram" FontSize="17" FontWeight="SemiBold"/>
                      </DockPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Rectangle x:Name="TgLed" Width="6" Height="6" Margin="0,1,7,0" VerticalAlignment="Center" Fill="#8A90A0"/>
                        <TextBlock x:Name="TgStatus" Text="Выключен · нажми на самолётик" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <UniformGrid x:Name="TgActions" Rows="1" Margin="0,12,0,0" Visibility="Collapsed">
                    <Button x:Name="TgConnect" Style="{StaticResource Btn}" Height="36" Padding="4,0" FontSize="12" Margin="0,0,3,0" Visibility="Collapsed" ToolTip="Настроить прокси в Telegram Desktop">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,1,7,0"/><TextBlock Text="Подключить на ПК"/></StackPanel>
                    </Button>
                    <Button x:Name="TgPhone" Style="{StaticResource Btn}" Height="36" Padding="4,0" FontSize="12" Margin="3,0,0,0" Visibility="Collapsed" ToolTip="Подключить Telegram на телефоне по QR-коду">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,1,7,0"/><TextBlock Text="На телефоне"/></StackPanel>
                    </Button>
                  </UniformGrid>
                </StackPanel>
              </Border>
              </StackPanel>
            </StackPanel>

            <StackPanel x:Name="TestHost" Grid.Row="1">
              <!-- кнопка обновления zapret появляется только когда вышла новая версия -->
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="TestBtn" Style="{StaticResource Btn}" Content="Тест стратегий"/>
                <Button x:Name="UpdateBtn" Grid.Column="1" Style="{StaticResource Btn}" Margin="8,0,0,0" MinWidth="150" Visibility="Collapsed">
                  <Grid>
                    <TextBlock x:Name="UpdText" Text="Обновления" HorizontalAlignment="Center"/>
                    <Border x:Name="UpdTrack" Height="3" VerticalAlignment="Bottom" Margin="-6,0,-6,-6" Background="#2A2E38" ClipToBounds="True" Opacity="0">
                      <Grid>
                        <Rectangle x:Name="UpdBar" Width="40" HorizontalAlignment="Left" RadiusX="0" RadiusY="0" Fill="#3DDC97">
                          <Rectangle.RenderTransform><TranslateTransform x:Name="UpdBarT" X="-40"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="UpdFill" RadiusX="0" RadiusY="0" Fill="#3DDC97" RenderTransformOrigin="0,0.5">
                          <Rectangle.RenderTransform><ScaleTransform x:Name="UpdFillS" ScaleX="0"/></Rectangle.RenderTransform>
                        </Rectangle>
                      </Grid>
                    </Border>
                  </Grid>
                </Button>
              </Grid>
            </StackPanel>
          </Grid>

          <!-- Правая колонка -->
          <Grid x:Name="RightCol" Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition x:Name="ApplyRow" Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- «Мои сайты» в свёрнутом виде: узкая вертикальная вкладка справа -->
            <Border x:Name="SitesStrip" Grid.RowSpan="2" Width="52" Background="{StaticResource Card}" BorderBrush="#262A33" BorderThickness="2"
                    Cursor="Hand" Visibility="Collapsed" Opacity="0" ToolTip="Развернуть «Мои сайты»">
              <Border.RenderTransform><TranslateTransform x:Name="SitesStripT"/></Border.RenderTransform>
              <DockPanel>
                <Path x:Name="StripChev" DockPanel.Dock="Top" Data="{StaticResource PxCollapse}" Fill="#8A90A0" Width="12" Height="10" Stretch="None"
                      HorizontalAlignment="Center" Margin="0,18,0,0" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform><TransformGroup><ScaleTransform ScaleX="-1"/><TranslateTransform x:Name="StripChevT"/></TransformGroup></Path.RenderTransform>
                </Path>
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16">
                  <Rectangle x:Name="StripApplyDot" Width="8" Height="8" Fill="#3DDC97" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed" ToolTip="Изменения применятся после перезапуска"/>
                  <TextBlock x:Name="StripCount" Style="{StaticResource PxText}" FontSize="16" Foreground="#8A90A0" HorizontalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StripTitle" Text="Мои сайты" Style="{StaticResource PxText}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
                </TextBlock>
              </DockPanel>
            </Border>

            <Border x:Name="SitesCard" Grid.Row="0" Background="{StaticResource Card}" Padding="18" BorderBrush="#262A33" BorderThickness="2">
              <Border.RenderTransform><TranslateTransform x:Name="SitesCardT"/></Border.RenderTransform>
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SitesCount" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="ShareBtn" Style="{StaticResource Btn}" Padding="10,5" FontSize="12" Margin="0,0,6,0" ToolTip="Выбрать сайты и получить код для друга">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,1,6,0"/><TextBlock Text="Поделиться"/></StackPanel>
                    </Button>
                    <Button x:Name="PasteBtn" Style="{StaticResource Btn}" Padding="10,5" FontSize="12" ToolTip="Ввести код от друга или вставить скопированный список">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,1,6,0"/><TextBlock Text="Ввести код"/></StackPanel>
                    </Button>
                    <Button x:Name="SitesCollapse" Style="{StaticResource TitleBtn}" Margin="6,0,-6,0" ToolTip="Свернуть «Мои сайты» вправо">
                      <Path Data="{StaticResource PxCollapse}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="10" Stretch="None" SnapsToDevicePixels="True"/>
                    </Button>
                  </StackPanel>
                  <TextBlock Text="Мои сайты" Style="{StaticResource PxText}" FontSize="22.22" VerticalAlignment="Center" Margin="0,0,0,2"/>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,12,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Background="#121419" BorderBrush="#2E3340" BorderThickness="2" Height="40" Margin="0,0,0,0">
                    <DockPanel>
                      <Path DockPanel.Dock="Left" Data="{StaticResource PxRight}" Fill="#3DDC97" VerticalAlignment="Center" Margin="12,0,2,0" SnapsToDevicePixels="True"/>
                      <Grid>
                        <TextBlock x:Name="DomainHint" Text="например: google.com" Foreground="#5A6070" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="DomainBox" Background="Transparent" BorderThickness="0" Foreground="#E6E8EE" CaretBrush="#3DDC97"
                                 Margin="4,0,10,0" VerticalAlignment="Center" FontSize="13"/>
                      </Grid>
                    </DockPanel>
                  </Border>
                  <Button x:Name="AddBtn" Grid.Column="1" Style="{StaticResource AccentBtn}" Content="Добавить" Margin="8,0,0,0" Height="43" VerticalAlignment="Top"/>
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="SitesPanel" Margin="0,0,6,0"/>
                </ScrollViewer>
              </Grid>
            </Border>


            <Border x:Name="ApplyBar" Grid.Row="1" Background="#1E2B26" Padding="14,8" Margin="0,10,0,0"
                    BorderBrush="#2D5A47" BorderThickness="1" Visibility="Collapsed" Opacity="0">
              <DockPanel>
                <Button x:Name="ApplyBtn" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Padding="12,6" Content="Перезапустить"/>
                <TextBlock Text="Изменения применятся после перезапуска" VerticalAlignment="Center" Foreground="#BFEBD6" FontSize="12" TextWrapping="Wrap"/>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- Плашка обновления приложения -->
        <Grid x:Name="AppUpdBar" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-6,0,0" Visibility="Collapsed" Opacity="0">
          <Grid.RenderTransform><TranslateTransform x:Name="AppUpdShift" Y="-30"/></Grid.RenderTransform>
          <!-- жёсткая пиксельная тень отдельным слоем: дешевле, чем эффект тени -->
          <Border Background="#99000000" Margin="5,5,-5,-5" IsHitTestVisible="False"/>
          <Border Background="#1B2B25" Padding="16,10" BorderBrush="#3DDC97" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Rectangle Width="8" Height="8" Fill="#3DDC97" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="AppUpdText" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="AppUpdBtn" Style="{StaticResource AccentBtn}" Content="Обновить" Padding="14,5"/>
                <Button x:Name="AppUpdLater" Style="{StaticResource TitleBtn}" Margin="6,0,0,0" ToolTip="Позже"><Path Data="{StaticResource PxX}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
              </StackPanel>
              <Border x:Name="AppUpdTrack" Height="4" Background="#22262F" Margin="0,8,0,0" Visibility="Collapsed">
                <Border x:Name="AppUpdFill" Background="#3DDC97" RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform><ScaleTransform x:Name="AppUpdFillS" ScaleX="0"/></Border.RenderTransform>
                </Border>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Панель настроек -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="2" Visibility="Collapsed">
          <Border x:Name="Dim" Background="#B0090A0D" Opacity="0"/>
          <Border x:Name="SettingsPanel" HorizontalAlignment="Right" Width="600" Background="#171A21"
                  BorderBrush="#2E3340" BorderThickness="2,0,0,0">
            <Border.RenderTransform><TranslateTransform x:Name="SettingsShift" X="620"/></Border.RenderTransform>
            <Grid Margin="22,18,22,20">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,18">
                <Button x:Name="SettingsClose" DockPanel.Dock="Right" Style="{StaticResource TitleBtn}"><Path Data="{StaticResource PxX}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
                <TextBlock Text="Настройки" Style="{StaticResource PxText}" FontSize="22.22" VerticalAlignment="Center"/>
              </DockPanel>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Вкладки -->
                <StackPanel x:Name="SetNav">
                  <RadioButton x:Name="Nav0" Style="{StaticResource NavItem}" Tag="0" IsChecked="True">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center"/><TextBlock Text="Обход" VerticalAlignment="Center"/></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="Nav1" Style="{StaticResource NavItem}" Tag="1">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center"/><TextBlock Text="Запуск" VerticalAlignment="Center"/></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="Nav2" Style="{StaticResource NavItem}" Tag="2">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center"/><TextBlock Text="Вид" VerticalAlignment="Center"/></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="Nav3" Style="{StaticResource NavItem}" Tag="3">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center"/><TextBlock Text="Инструменты" VerticalAlignment="Center"/></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="Nav4" Style="{StaticResource NavItem}" Tag="4">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="26" VerticalAlignment="Center"/><TextBlock Text="О программе" VerticalAlignment="Center"/></StackPanel>
                  </RadioButton>
                </StackPanel>

                <!-- Содержимое вкладок -->
                <Grid x:Name="SetPages" Grid.Column="2">
                  <!-- 0: Обход -->
                  <StackPanel x:Name="SetPage0">
                    <TextBlock Text="Обход" Style="{StaticResource PxText}" FontSize="22.22" Margin="0,0,0,4"/>
                    <TextBlock Text="как zapret обходит блокировки" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource SetCard}">
                      <StackPanel>
                        <Grid Margin="0,0,0,12">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Игровой фильтр" FontSize="13"/>
                            <TextBlock Text="обход для игр (порты 1024+)" Foreground="{StaticResource Muted}" FontSize="11"/>
                          </StackPanel>
                          <ComboBox x:Name="GameBox" Grid.Column="1">
                            <ComboBoxItem Tag="disabled">Выключен</ComboBoxItem>
                            <ComboBoxItem Tag="all">TCP и UDP</ComboBoxItem>
                            <ComboBoxItem Tag="tcp">Только TCP</ComboBoxItem>
                            <ComboBoxItem Tag="udp">Только UDP</ComboBoxItem>
                          </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="IPSet фильтр" FontSize="13"/>
                            <TextBlock Text="обход по списку IP-адресов" Foreground="{StaticResource Muted}" FontSize="11"/>
                          </StackPanel>
                          <ComboBox x:Name="IpsetBox" Grid.Column="1">
                            <ComboBoxItem Tag="loaded">По списку</ComboBoxItem>
                            <ComboBoxItem Tag="none">Выключен</ComboBoxItem>
                            <ComboBoxItem Tag="any">Все IP</ComboBoxItem>
                          </ComboBox>
                        </Grid>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Показывать окно winws" FontSize="13"/>
                            <TextBlock Text="чёрное окно с логом; обычно не нужно" Foreground="{StaticResource Muted}" FontSize="11"/>
                          </StackPanel>
                          <CheckBox x:Name="WinToggle" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- 1: Запуск -->
                  <StackPanel x:Name="SetPage1" Visibility="Collapsed">
                    <TextBlock Text="Запуск" Style="{StaticResource PxText}" FontSize="22.22" Margin="0,0,0,4"/>
                    <TextBlock Text="как открывается приложение" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource SetCard}">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Проверять обновления при запуске" FontSize="13"/>
                            <TextBlock Text="приложения и zapret" Foreground="{StaticResource Muted}" FontSize="11"/>
                          </StackPanel>
                          <CheckBox x:Name="UpdToggle" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetCard}" Margin="0,10,0,0">
                      <StackPanel>
                        <Grid Margin="0,0,0,12">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Запускать вместе с Windows" FontSize="13"/>
                            <TextBlock Text="Zapret откроется в трее и сам включит zapret" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                          </StackPanel>
                          <CheckBox x:Name="AutoRunToggle" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Кнопка ✕" FontSize="13"/>
                            <TextBlock Text="что делать при закрытии окна" Foreground="{StaticResource Muted}" FontSize="11"/>
                          </StackPanel>
                          <ComboBox x:Name="CloseBox" Grid.Column="1" VerticalAlignment="Center">
                            <ComboBoxItem Tag="ask">Спрашивать</ComboBoxItem>
                            <ComboBoxItem Tag="tray">Сворачивать в трей</ComboBoxItem>
                            <ComboBoxItem Tag="exit">Закрывать полностью</ComboBoxItem>
                          </ComboBox>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <!-- 2: Вид -->
                  <StackPanel x:Name="SetPage2" Visibility="Collapsed">
                    <TextBlock Text="Вид" Style="{StaticResource PxText}" FontSize="22.22" Margin="0,0,0,4"/>
                    <TextBlock Text="применяется сразу, окно перезапустится" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource SetCard}">
                      <StackPanel>
                        <Grid Margin="0,0,0,12">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Тема" FontSize="13" VerticalAlignment="Center"/>
                          <ComboBox x:Name="ThemeBox" Grid.Column="1">
                            <ComboBoxItem Tag="dark">Тёмная</ComboBoxItem>
                            <ComboBoxItem Tag="light">Светлая</ComboBoxItem>
                          </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Язык" FontSize="13" VerticalAlignment="Center"/>
                          <ComboBox x:Name="LangBox" Grid.Column="1">
                            <ComboBoxItem Tag="ru">Русский</ComboBoxItem>
                            <ComboBoxItem Tag="en">English</ComboBoxItem>
                          </ComboBox>
                        </Grid>
                        <TextBlock Text="Акцентный цвет" FontSize="13" Margin="0,2,0,8"/>
                        <WrapPanel x:Name="AccentPanel" Margin="-4,0,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SetCard}" Margin="0,10,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                          <TextBlock FontSize="13"><Run Text="&#xEC0A;" FontFamily="Segoe MDL2 Assets" Foreground="#3DDC97"/><Run Text="  Режим экономии"/></TextBlock>
                          <TextBlock Text="без анимаций и эффектов — меньше нагрузка на компьютер и батарею ноутбука. Всё работает как обычно" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="EcoToggle" Grid.Column="1" Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </StackPanel>

                  <!-- 3: Инструменты -->
                  <StackPanel x:Name="SetPage3" Visibility="Collapsed">
                    <TextBlock Text="Инструменты" Style="{StaticResource PxText}" FontSize="22.22" Margin="0,0,0,4"/>
                    <TextBlock Text="обслуживание zapret и приложения" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,16"/>
                    <Button x:Name="ServiceBtn" Style="{StaticResource RowBtn}">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="#3DDC97"/>
                        <StackPanel><TextBlock Text="Сервис и диагностика" FontSize="13"/><TextBlock Text="служба, статус и проверка zapret" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel>
                    </Button>
                    <Button x:Name="FolderBtn" Style="{StaticResource RowBtn}">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="#3DDC97"/>
                        <StackPanel><TextBlock Text="Открыть папку zapret" FontSize="13"/><TextBlock Text="списки, батники и логи" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel>
                    </Button>
                    <Button x:Name="MigrateBtn" Style="{StaticResource RowBtn}">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="#3DDC97"/>
                        <StackPanel><TextBlock Text="Перенести настройки из старой версии" FontSize="13"/><TextBlock Text="если вышла новая версия zapret" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel>
                    </Button>
                    <Button x:Name="UninstBtn" Style="{StaticResource RowBtn}">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="#E0566A"/>
                        <StackPanel><TextBlock Text="Удалить Zapret" FontSize="13"/><TextBlock Text="полностью или оставить zapret от Flowseal" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel>
                    </Button>
                    <Button x:Name="ZapretCheckBtn" Style="{StaticResource RowBtn}">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="#3DDC97"/>
                        <StackPanel><TextBlock Text="Проверить обновления zapret" FontSize="13"/><TextBlock Text="новая версия zapret от Flowseal" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel>
                    </Button>
                    <Button x:Name="AppCheckBtn" Style="{StaticResource RowBtn}">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="#3DDC97"/>
                        <StackPanel><TextBlock Text="Проверить обновления приложения" FontSize="13"/><TextBlock Text="скачать новую версию с GitHub" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel>
                    </Button>
                  </StackPanel>

                  <!-- 4: О программе -->
                  <StackPanel x:Name="SetPage4" Visibility="Collapsed">
                    <TextBlock Text="О программе" Style="{StaticResource PxText}" FontSize="22.22" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource SetCard}" Margin="0,0,0,10">
                      <StackPanel>
                        <TextBlock Style="{StaticResource PxText}" FontSize="22.22">
                          <Run Text="Zapret GUI "/><Run Text="by " Foreground="#8A90A0" FontWeight="Normal" FontSize="14"/><Run Text="COFFIOK" Foreground="#3DDC97" FontWeight="Bold" FontSize="14"/>
                        </TextBlock>
                        <TextBlock x:Name="InfoApp" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/>
                        <TextBlock Text="Версия" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock x:Name="InfoVer" FontSize="12.5" Margin="0,2,0,10"/>
                        <TextBlock Text="Папка zapret" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock x:Name="InfoPath" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Border>
                    <Button x:Name="FbBtn" Style="{StaticResource RowBtn}">
                      <StackPanel Orientation="Horizontal"><Path Data="{StaticResource PxChat}" Fill="#3DDC97" Width="30" Height="16" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Left" SnapsToDevicePixels="True"/>
                        <StackPanel><TextBlock Text="Чат с разработчиком" FontSize="13"/><TextBlock Text="ошибка, идея или вопрос — автор ответит здесь же" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel>
                    </Button>
                    <Button x:Name="RepoBtn" Style="{StaticResource RowBtn}">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="30" VerticalAlignment="Center" Foreground="#3DDC97"/>
                        <StackPanel><TextBlock Text="Страница на GitHub" FontSize="13"/><TextBlock Text="описание, релизы и обновления" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel>
                    </Button>
                    <TextBlock Text="zapret, tg-ws-proxy — Flowseal · bol-van · WinDivert — basil00" Foreground="#5A6070" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- Тест стратегий -->
        <Grid x:Name="TestOverlay" Grid.RowSpan="2" Visibility="Collapsed">
          <Border x:Name="TestDim" Background="#C0090A0D" Opacity="0"/>
          <Grid x:Name="TestPanel" Margin="26,22,26,22" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="TestScale" ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
            <!-- жёсткая пиксельная тень отдельным слоем: дешевле, чем эффект тени -->
            <Border Background="#99000000" Margin="7,7,-7,-7" IsHitTestVisible="False"/>
            <Border Background="#171A21" BorderBrush="#2A2E38" BorderThickness="2">
              <Grid Margin="26,18,26,20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                  <Button x:Name="TestClose" DockPanel.Dock="Right" Style="{StaticResource TitleBtn}"><Path Data="{StaticResource PxX}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
                  <StackPanel>
                    <TextBlock Text="Тест стратегий" Style="{StaticResource PxText}" FontSize="22.22"/>
                    <TextBlock Text="Проверяю, какая стратегия лучше открывает твои сайты" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>

                <!-- всё видно сразу: компактная сетка без прокрутки -->
                <StackPanel x:Name="TestSetup" Grid.Row="1">
                  <DockPanel Margin="2,0,0,6">
                    <Button x:Name="GroupAll" DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="10,2" FontSize="11.5" Content="Снять все"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="ЧТО ПРОВЕРЯТЬ" FontSize="11" FontWeight="SemiBold" Foreground="#8A90A0"/>
                      <TextBlock x:Name="GroupCount" Foreground="#5A6070" FontSize="11" Margin="8,0,0,0"/>
                    </StackPanel>
                  </DockPanel>
                  <WrapPanel x:Name="GroupChips" ItemWidth="195" Margin="0,0,0,12"/>
                  <DockPanel Margin="2,0,0,6">
                    <Button x:Name="StratAll" DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="10,2" FontSize="11.5" Content="Снять все"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="СТРАТЕГИИ" FontSize="11" FontWeight="SemiBold" Foreground="#8A90A0"/>
                      <TextBlock x:Name="StratCount" Foreground="#5A6070" FontSize="11" Margin="8,0,0,0"/>
                    </StackPanel>
                  </DockPanel>
                  <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="StratChips" ItemWidth="195"/>
                  </ScrollViewer>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,14,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="TestStatus" FontSize="12.5" Foreground="#B8BDC9" TextTrimming="CharacterEllipsis"/>
                    <Border Height="8" Background="#22262F" Margin="0,8,0,0" ClipToBounds="True">
                      <Grid>
                        <Border x:Name="TestBar" RenderTransformOrigin="0,0.5">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                              <GradientStop Color="#2BB57A" Offset="0"/>
                              <GradientStop Color="#3DDC97" Offset="1"/>
                            </LinearGradientBrush>
                          </Border.Background>
                          <Border.RenderTransform><ScaleTransform x:Name="TestBarScale" ScaleX="0"/></Border.RenderTransform>
                        </Border>
                        <Rectangle x:Name="TestShimmer" Width="120" HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False">
                          <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                              <GradientStop Color="#00FFFFFF" Offset="0"/>
                              <GradientStop Color="#55FFFFFF" Offset="0.5"/>
                              <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                          </Rectangle.Fill>
                          <Rectangle.RenderTransform><TranslateTransform x:Name="TestShimmerT" X="-120"/></Rectangle.RenderTransform>
                        </Rectangle>
                      </Grid>
                    </Border>
                  </StackPanel>
                  <Button x:Name="RunBtn" Grid.Column="1" Style="{StaticResource AccentBtn}" Content="Запустить тест" Padding="20,10" MinWidth="150"/>
                </Grid>

                <Grid Grid.Row="3">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <TextBlock x:Name="ResultsHead" Text="РЕЗУЛЬТАТЫ · нажми на строку, чтобы увидеть сайты" FontSize="11" FontWeight="SemiBold" Foreground="#5A6070" Margin="2,0,0,8" Visibility="Collapsed"/>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TestResults" Margin="0,0,6,0"/>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Перенос настроек -->
        <Grid x:Name="MigOverlay" Grid.RowSpan="2" Visibility="Collapsed">
          <Border x:Name="MigDim" Background="#C0090A0D" Opacity="0"/>
          <Grid x:Name="MigPanel" Width="600" Margin="0,22" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="MigScale" ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
            <!-- жёсткая пиксельная тень отдельным слоем: дешевле, чем эффект тени -->
            <Border Background="#99000000" Margin="7,7,-7,-7" IsHitTestVisible="False"/>
            <Border Background="#171A21" BorderBrush="#2A2E38" BorderThickness="2">
              <Grid Margin="26,18,26,20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                  <Button x:Name="MigClose" DockPanel.Dock="Right" Style="{StaticResource TitleBtn}"><Path Data="{StaticResource PxX}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
                  <StackPanel>
                    <TextBlock Text="Перенос настроек" Style="{StaticResource PxText}" FontSize="22.22"/>
                    <TextBlock Text="Твои сайты, группы и настройки переедут в новую версию zapret" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>

                <Grid x:Name="MigCards" Grid.Row="1" Margin="0,0,0,14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Background="#1E2129" Padding="14,12" BorderBrush="#2A2E38" BorderThickness="2">
                    <StackPanel>
                      <TextBlock Text="ОТКУДА · старая" FontSize="10.5" FontWeight="SemiBold" Foreground="#5A6070" Margin="2,0,0,8"/>
                      <ComboBox x:Name="MigFromBox"/>
                    </StackPanel>
                  </Border>
                  <Canvas Grid.Column="1" Height="10" Width="60" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <StackPanel.RenderTransform><TranslateTransform x:Name="MigDotsT" X="-40"/></StackPanel.RenderTransform>
                      <Rectangle Width="6" Height="6" Fill="#3DDC97" Margin="0,2,14,2" Opacity="0.35"/>
                      <Rectangle Width="6" Height="6" Fill="#3DDC97" Margin="0,2,14,2" Opacity="0.6"/>
                      <Rectangle Width="6" Height="6" Fill="#3DDC97" Margin="0,2,14,2" Opacity="1"/>
                      <Rectangle Width="6" Height="6" Fill="#3DDC97" Margin="0,2,14,2" Opacity="0.35"/>
                      <Rectangle Width="6" Height="6" Fill="#3DDC97" Margin="0,2,14,2" Opacity="0.6"/>
                      <Rectangle Width="6" Height="6" Fill="#3DDC97" Margin="0,2,14,2" Opacity="1"/>
                    </StackPanel>
                  </Canvas>
                  <Border Grid.Column="2" Background="#1A2621" Padding="14,12" BorderBrush="#2D5A47" BorderThickness="1">
                    <Border.Effect><DropShadowEffect x:Name="MigToGlow" Color="#3DDC97" BlurRadius="0" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                    <StackPanel>
                      <TextBlock Text="КУДА · новая" FontSize="10.5" FontWeight="SemiBold" Foreground="#5A9C80" Margin="2,0,0,8"/>
                      <ComboBox x:Name="MigToBox"/>
                    </StackPanel>
                  </Border>
                </Grid>


                <ScrollViewer x:Name="MigScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="MigSteps" Margin="0,0,6,0"/>
                </ScrollViewer>
                <StackPanel x:Name="MigEmpty" Grid.Row="2" Panel.ZIndex="5" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                  <TextBlock Text="📦" FontFamily="Segoe UI Emoji" FontSize="40" HorizontalAlignment="Center"/>
                  <TextBlock Text="Новая версия zapret не найдена" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                  <TextBlock Text="Скачай новую версию и распакуй её в папку Zapret рядом с текущей. Потом открой это окно снова." Foreground="{StaticResource Muted}"
                             FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button x:Name="MigOpenFolder" Style="{StaticResource Btn}" Content="Открыть папку Zapret" Margin="0,0,8,0"/>
                    <Button x:Name="MigDemo" Style="{StaticResource AccentBtn}" Content="Посмотреть демо"/>
                  </StackPanel>
                </StackPanel>

                <DockPanel Grid.Row="3" Margin="0,14,0,0">
                  <Button x:Name="MigRun" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Content="Перенести" Padding="22,10" MinWidth="140"/>
                  <TextBlock x:Name="MigDone" Text="Готово! Оригиналы файлов автора сохранены как .bak" Foreground="#7FE8B8" FontSize="12.5"
                             VerticalAlignment="Center" Visibility="Collapsed" Opacity="0" TextWrapping="Wrap"/>
                </DockPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Поделиться / Вставить -->
        <Grid x:Name="ShareOverlay" Grid.RowSpan="2" Visibility="Collapsed">
          <Border x:Name="ShareDim" Background="#C0090A0D" Opacity="0"/>
          <Grid x:Name="SharePanel" Width="560" Margin="0,22" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="ShareScale" ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
            <!-- жёсткая пиксельная тень отдельным слоем: дешевле, чем эффект тени -->
            <Border Background="#99000000" Margin="7,7,-7,-7" IsHitTestVisible="False"/>
            <Border Background="#171A21" BorderBrush="#2A2E38" BorderThickness="2">
              <Grid Margin="26,18,26,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                  <Button x:Name="ShareClose" DockPanel.Dock="Right" Style="{StaticResource TitleBtn}"><Path Data="{StaticResource PxX}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
                  <StackPanel>
                    <TextBlock x:Name="ShareTitle" Style="{StaticResource PxText}" FontSize="22.22"/>
                    <TextBlock x:Name="ShareSub" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
                <DockPanel x:Name="ShareCountRow" Grid.Row="1" Margin="2,0,8,8">
                  <TextBlock x:Name="ShareAll" DockPanel.Dock="Right" Text="Снять все" Foreground="#7FE8B8" FontSize="12" Cursor="Hand"/>
                  <TextBlock x:Name="ShareCount" Foreground="{StaticResource Muted}" FontSize="12"/>
                </DockPanel>
                <Border x:Name="ShareListBox" Grid.Row="2" Background="#1E2129" BorderBrush="#262A33" BorderThickness="1" Padding="6">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ShareList" Margin="8,6,10,6"/>
                  </ScrollViewer>
                </Border>
                <!-- готовый код -->
                <StackPanel x:Name="ShareCodeView" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,0,10">
                  <TextBlock Text="Код для друга" Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center"/>
                  <Border x:Name="ShareCodeCard" Background="#1B3329" BorderBrush="#2D5A47" BorderThickness="1" Padding="34,14,34,16"
                          HorizontalAlignment="Center" Margin="0,12,0,12" Cursor="Hand" ToolTip="Нажми, чтобы скопировать" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="ShareCodeScale"/></Border.RenderTransform>
                    <TextBlock x:Name="ShareCodeText" FontFamily="Consolas" FontSize="44" FontWeight="Bold" Foreground="#3DDC97"/>
                  </Border>
                  <TextBlock x:Name="ShareCodeInfo" Foreground="{StaticResource Muted}" FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                </StackPanel>
                <!-- ввод кода -->
                <StackPanel x:Name="ShareEnterView" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,0,10">
                  <TextBlock Text="Введи код, который прислал друг" FontSize="14" HorizontalAlignment="Center"/>
                  <Border x:Name="ShareCodeBoxWrap" Width="300" Height="66" Background="#22262F" BorderBrush="#2E3340" BorderThickness="1" Margin="0,14,0,10">
                    <TextBox x:Name="ShareCodeBox" Background="Transparent" BorderThickness="0" Foreground="#E6E8EE" CaretBrush="#3DDC97"
                             FontFamily="Consolas" FontSize="32" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                             CharacterCasing="Upper" MaxLength="9"/>
                  </Border>
                  <TextBlock x:Name="ShareEnterMsg" Foreground="{StaticResource Muted}" FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400" MinHeight="18"/>
                  <TextBlock x:Name="SharePasteList" Text="Прислали список текстом? Скопируй его и нажми сюда" Foreground="#7FE8B8" FontSize="12" Cursor="Hand"
                             HorizontalAlignment="Center" Margin="0,22,0,0"/>
                </StackPanel>
                <DockPanel Grid.Row="3" Margin="0,14,0,0">
                  <Button x:Name="ShareGo" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Padding="22,10" MinWidth="150"/>
                  <Button x:Name="ShareAlt" DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="16,10" Margin="0,0,10,0" Visibility="Collapsed"/>
                  <TextBlock/>
                </DockPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Чат с разработчиком -->
        <Grid x:Name="FbOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="40">
          <Border x:Name="FbDim" Background="#C0090A0D" Opacity="0"/>
          <Grid x:Name="FbPanel" Width="560" Margin="0,22" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="FbScale" ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
            <!-- жёсткая пиксельная тень отдельным слоем: дешевле, чем эффект тени -->
            <Border Background="#99000000" Margin="7,7,-7,-7" IsHitTestVisible="False"/>
            <Border Background="#171A21" BorderBrush="#2A2E38" BorderThickness="2">
              <Grid Margin="0,18,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="26,0,26,12">
                  <Button x:Name="FbClose" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource TitleBtn}"><Path Data="{StaticResource PxX}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
                  <StackPanel>
                    <TextBlock Text="Чат с разработчиком" Style="{StaticResource PxText}" FontSize="22.22"/>
                    <TextBlock Text="Пиши об ошибках, идеях и вопросах — автор Zapret ответит здесь же" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="FbNickLine" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                      <TextBlock Text="ты пишешь как" Foreground="{StaticResource Muted}" FontSize="12"/>
                      <TextBlock x:Name="FbNickName" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0"/>
                      <TextBlock x:Name="FbNickEdit" Text="изменить" Foreground="#3DDC97" FontSize="12" Cursor="Hand" Margin="12,0,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="#13151B" BorderBrush="#22252D" BorderThickness="0,2,0,2">
                  <Grid>
                    <ScrollViewer x:Name="FbScroll" VerticalScrollBarVisibility="Auto" Padding="20,14,14,14">
                      <StackPanel x:Name="FbList"/>
                    </ScrollViewer>
                    <StackPanel x:Name="FbEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                      <Path Data="{StaticResource PxChat}" Fill="#3A3F4B" Width="16" Height="16" Stretch="None" HorizontalAlignment="Center" SnapsToDevicePixels="True">
                        <Path.LayoutTransform><ScaleTransform ScaleX="3" ScaleY="3"/></Path.LayoutTransform>
                      </Path>
                      <TextBlock Text="Здесь пока пусто" Style="{StaticResource PxText}" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                      <TextBlock Text="Расскажи, что не работает или чего не хватает. Ответ придёт в этот чат — Zapret подскажет, когда он появится." Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <StackPanel Grid.Row="2" Margin="20,12,20,16">
                  <!-- сначала — ник -->
                  <StackPanel x:Name="FbNickPanel" Visibility="Collapsed">
                    <TextBlock Text="Как к тебе обращаться?" FontSize="13" Margin="0,0,0,2"/>
                    <TextBlock Text="Ник увидит только автор. Можно любой — не обязательно настоящее имя." Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <DockPanel>
                      <Button x:Name="FbNickSave" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Content="Продолжить" Padding="18,0" Margin="8,0,0,0"/>
                      <Border Background="#22262F" BorderBrush="#2E3340" BorderThickness="2" Height="44">
                        <Grid>
                          <TextBlock x:Name="FbNickHint" Text="Ник, например: Вася" Foreground="#5A6070" FontSize="13" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                          <TextBox x:Name="FbNickBox" Background="Transparent" BorderThickness="0" Foreground="#E6E8EE" CaretBrush="#3DDC97" FontSize="13"
                                   Padding="8,0" VerticalContentAlignment="Center" MaxLength="24"/>
                        </Grid>
                      </Border>
                    </DockPanel>
                  </StackPanel>
                  <!-- блокировка -->
                  <Border x:Name="FbBanPanel" Background="#2A1A1D" BorderBrush="#5A2A30" BorderThickness="2" Padding="14,10" Visibility="Collapsed">
                    <StackPanel>
                      <TextBlock Text="Ты не можешь писать в чат" FontSize="13" FontWeight="SemiBold" Foreground="#FF8A8E"/>
                      <TextBlock x:Name="FbBanText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                  <!-- обычная отправка -->
                  <StackPanel x:Name="FbComposer">
                    <DockPanel x:Name="FbAttachRow" Margin="0,0,0,8" Visibility="Collapsed">
                      <Border BorderBrush="#2E3340" BorderThickness="2" DockPanel.Dock="Left">
                        <Image x:Name="FbAttachImg" MaxHeight="64" MaxWidth="120" Stretch="Uniform"/>
                      </Border>
                      <TextBlock x:Name="FbAttachDel" Text="убрать" Foreground="#3DDC97" FontSize="12" Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                      <CheckBox x:Name="FbLog" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center" IsChecked="True"/>
                      <TextBlock x:Name="FbLogText" Text="журнал" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                 ToolTip="Приложить последние записи журнала работы — без имени пользователя и путей. Помогает найти ошибку."/>
                      <WrapPanel VerticalAlignment="Center">
                        <RadioButton x:Name="FbKindBug" GroupName="FbKind" Style="{StaticResource Chip}" Content="Ошибка" IsChecked="True" Margin="0,0,6,0"/>
                        <RadioButton x:Name="FbKindIdea" GroupName="FbKind" Style="{StaticResource Chip}" Content="Идея" Margin="0,0,6,0"/>
                        <RadioButton x:Name="FbKindOther" GroupName="FbKind" Style="{StaticResource Chip}" Content="Вопрос" Margin="0,0,6,0"/>
                      </WrapPanel>
                    </DockPanel>
                    <DockPanel>
                      <Button x:Name="FbSend" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Padding="16,0" Margin="8,0,0,0" MinWidth="56" ToolTip="Отправить (Enter)">
                        <Path Data="M0,0h2v2h2v2h2v2h2v2h-2v2h-2v2h-2v2h-2z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="8" Height="14" Stretch="None" SnapsToDevicePixels="True"/>
                      </Button>
                      <Button x:Name="FbAttach" DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="12,0" Margin="8,0,0,0" ToolTip="Прикрепить фото или скриншот (можно вставить через Ctrl+V)">
                        <Path Data="M0,2h14v10h-14z M2,4v6h10v-6z M3,9h2v-2h2v-2h2v2h2v2z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="None" SnapsToDevicePixels="True"/>
                      </Button>
                      <Border Background="#22262F" BorderBrush="#2E3340" BorderThickness="2" MinHeight="44">
                        <Grid>
                          <TextBlock x:Name="FbHint" Text="Сообщение… (Shift+Enter — новая строка)" Foreground="#5A6070" FontSize="13" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                          <TextBox x:Name="FbText" Background="Transparent" BorderThickness="0" Foreground="#E6E8EE" CaretBrush="#3DDC97" FontSize="13"
                                   Padding="8,10" AcceptsReturn="False" TextWrapping="Wrap" MaxLength="2000" MaxHeight="110" VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                      </Border>
                    </DockPanel>
                  </StackPanel>
                  <TextBlock x:Name="FbMsg" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Согласие на анонимную статистику (один раз) -->
        <Grid x:Name="CsOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="45">
          <Border x:Name="CsDim" Background="#C0090A0D" Opacity="0"/>
          <Grid x:Name="CsPanel" Width="440" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="CsScale" ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
            <!-- жёсткая пиксельная тень отдельным слоем: дешевле, чем эффект тени -->
            <Border Background="#99000000" Margin="7,7,-7,-7" IsHitTestVisible="False"/>
            <Border Background="#171A21" BorderBrush="#2A2E38" BorderThickness="2">
              <StackPanel Margin="28,24,28,22">
                <TextBlock Text="Отправить данные анонимно?" Style="{StaticResource PxText}" FontSize="20" TextWrapping="Wrap"/>
                <DockPanel Margin="0,22,0,0">
                  <Button x:Name="CsYes" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Content="Отправить" Padding="22,10" MinWidth="140"/>
                  <Button x:Name="CsNo" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Нет" Padding="22,10" Margin="0,0,10,0"/>
                  <TextBlock/>
                </DockPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- Удаление Zapret -->
        <Grid x:Name="UninstOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="45">
          <Border x:Name="UninstDim" Background="#C0090A0D" Opacity="0"/>
          <Grid x:Name="UninstPanel" Width="520" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="UninstScale" ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
            <!-- жёсткая пиксельная тень отдельным слоем: дешевле, чем эффект тени -->
            <Border Background="#99000000" Margin="7,7,-7,-7" IsHitTestVisible="False"/>
            <Border Background="#171A21" BorderBrush="#2A2E38" BorderThickness="2">
              <StackPanel Margin="26,20,26,22">
                <DockPanel Margin="0,0,0,14">
                  <Button x:Name="UninstClose" DockPanel.Dock="Right" Style="{StaticResource TitleBtn}"><Path Data="{StaticResource PxX}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
                  <StackPanel>
                    <TextBlock Text="Удалить Zapret" Style="{StaticResource PxText}" FontSize="22.22"/>
                    <TextBlock Text="Выбери, что сделать с zapret от Flowseal" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
                <StackPanel x:Name="UninstChoice">
                  <Border x:Name="UnKeep" Background="#1E2129" BorderBrush="#2E3340" BorderThickness="2" Padding="16,14" Margin="0,0,0,10" Cursor="Hand">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="38" VerticalAlignment="Center" Foreground="#3DDC97"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Оставить zapret от Flowseal" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UnKeepSub" Text="Удалится только приложение. Папка zapret со всеми твоими сайтами и настройками переедет на рабочий стол." Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                      </StackPanel>
                      <Grid Grid.Column="2" Width="20" Height="20" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Rectangle Stroke="#3A3F4B" StrokeThickness="2"/>
                        <Rectangle x:Name="UnKeepDot" Width="10" Height="10" Fill="#3DDC97" Opacity="0"/>
                      </Grid>
                    </Grid>
                  </Border>
                  <Border x:Name="UnAll" Background="#1E2129" BorderBrush="#2E3340" BorderThickness="2" Padding="16,14" Margin="0,0,0,10" Cursor="Hand">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="38" VerticalAlignment="Center" Foreground="#E0566A"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Удалить всё" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UnAllSub" Text="Приложение, zapret, Telegram-прокси и твои списки сайтов — ничего не останется." Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                      </StackPanel>
                      <Grid Grid.Column="2" Width="20" Height="20" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Rectangle Stroke="#3A3F4B" StrokeThickness="2"/>
                        <Rectangle x:Name="UnAllDot" Width="10" Height="10" Fill="#3DDC97" Opacity="0"/>
                      </Grid>
                    </Grid>
                  </Border>
                </StackPanel>
                <TextBlock x:Name="UninstStatus" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="2,4,0,0" MinHeight="18"/>
                <DockPanel Margin="0,14,0,0">
                  <Button x:Name="UninstGo" DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Background="#E0566A" Foreground="#FFFFFF" Padding="22,10" MinWidth="150" Content="Удалить"/>
                  <Button x:Name="UninstCancel" DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="18,10" Margin="0,0,10,0" Content="Отмена"/>
                  <TextBlock/>
                </DockPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- QR для телефона -->
        <!-- Обновление приложения -->
        <Grid x:Name="AuOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="60">
          <Border x:Name="AuDim" Background="#C0090A0D" Opacity="0"/>
          <Grid x:Name="AuPanel" Width="380" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="AuScale" ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
            <!-- жёсткая пиксельная тень отдельным слоем: дешевле, чем эффект тени -->
            <Border Background="#99000000" Margin="7,7,-7,-7" IsHitTestVisible="False"/>
            <Border Background="#171A21" BorderBrush="#2A2E38" BorderThickness="2">
              <StackPanel Margin="28,30,28,26">
                <Grid Width="96" Height="96" HorizontalAlignment="Center" RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True">
                  <Path x:Name="AuRing" Fill="#22262F"/>
                  <Path x:Name="AuArc" Fill="#3DDC97"/>
                  <Image x:Name="AuLogo" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform><ScaleTransform x:Name="AuLogoS"/></Image.RenderTransform>
                  </Image>
                  <Grid x:Name="AuOk" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="AuOkS" ScaleX="0.4" ScaleY="0.4"/></Grid.RenderTransform>
                    <Path x:Name="AuOkDisc" Fill="#3DDC97"/>
                    <Path Data="M0,16h6v6h-6z M6,22h6v6h-6z M12,28h6v6h-6z M18,22h6v6h-6z M24,16h6v6h-6z M30,10h6v6h-6z M36,4h6v6h-6z" Fill="#0F1115" Width="42" Height="34" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <Path x:Name="AuBurst" Fill="#3DDC97" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><ScaleTransform x:Name="AuBurstS"/></Path.RenderTransform>
                  </Path>
                </Grid>
                <TextBlock x:Name="AuTitle" Style="{StaticResource PxText}" FontSize="22.22" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,18,0,4"/>
                <TextBlock x:Name="AuSub" Foreground="#8A90A0" FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel x:Name="AuProgress">
                  <Border Height="6" Background="#22262F" Margin="0,18,0,0" ClipToBounds="True">
                    <Border Background="#3DDC97" RenderTransformOrigin="0,0.5">
                      <Border.RenderTransform><ScaleTransform x:Name="AuFillS" ScaleX="0"/></Border.RenderTransform>
                    </Border>
                  </Border>
                  <TextBlock x:Name="AuPct" FontSize="11.5" Foreground="#8A90A0" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
                <Border x:Name="AuNews" Visibility="Collapsed" Background="#1E2129" Padding="14,12" Margin="0,16,0,0" BorderBrush="#262A33" BorderThickness="1">
                  <StackPanel x:Name="AuNewsList"/>
                </Border>
                <StackPanel x:Name="AuBtns" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed">
                  <Button x:Name="AuNewsBtn" Style="{StaticResource Btn}" Content="Что нового" Margin="0,0,8,0" Padding="16,8"/>
                  <Button x:Name="AuOkBtn" Style="{StaticResource AccentBtn}" Content="Отлично" Padding="20,8"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- Что делать по ✕ -->
        <Grid x:Name="CloseOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="50">
          <Border x:Name="CloseDim" Background="#C0090A0D" Opacity="0"/>
          <Grid x:Name="ClosePanel" Width="420" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="CloseScale" ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
            <!-- жёсткая пиксельная тень отдельным слоем: дешевле, чем эффект тени -->
            <Border Background="#99000000" Margin="7,7,-7,-7" IsHitTestVisible="False"/>
            <Border Background="#171A21" BorderBrush="#2A2E38" BorderThickness="2">
              <StackPanel Margin="24,18,24,22">
                <DockPanel Margin="0,0,0,6">
                  <Button x:Name="CloseAskX" DockPanel.Dock="Right" Style="{StaticResource TitleBtn}"><Path Data="{StaticResource PxX}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
                  <TextBlock Text="Закрыть Zapret?" Style="{StaticResource PxText}" FontSize="22.22" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Выбор запомнится. Поменять можно в настройках → Запуск." Foreground="#8A90A0" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Button x:Name="CloseToTray" Style="{StaticResource Btn}" Padding="14,12" Margin="0,0,0,8">
                  <Grid Width="330">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#3DDC97" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Свернуть в трей" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Значок останется рядом с часами, zapret и Telegram продолжат работать" Foreground="#8A90A0" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                </Button>
                <Button x:Name="CloseToExit" Style="{StaticResource Btn}" Padding="14,12">
                  <Grid Width="330">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FF8C99" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Закрыть полностью" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="Окно и значок закроются. Включённый zapret продолжит работать" Foreground="#8A90A0" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <Grid x:Name="QrOverlay" Grid.RowSpan="2" Visibility="Collapsed">
          <Border x:Name="QrDim" Background="#C0090A0D" Opacity="0"/>
          <Grid x:Name="QrPanel" Width="440" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="QrScale" ScaleX="0.94" ScaleY="0.94"/></Grid.RenderTransform>
            <!-- жёсткая пиксельная тень отдельным слоем: дешевле, чем эффект тени -->
            <Border Background="#99000000" Margin="7,7,-7,-7" IsHitTestVisible="False"/>
            <Border Background="#171A21" BorderBrush="#2A2E38" BorderThickness="2">
              <StackPanel Margin="26,18,26,22">
                <DockPanel Margin="0,0,0,10">
                  <Button x:Name="QrClose" DockPanel.Dock="Right" Style="{StaticResource TitleBtn}"><Path Data="{StaticResource PxX}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/></Button>
                  <TextBlock Text="Telegram на телефоне" Style="{StaticResource PxText}" FontSize="22.22" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="1. Телефон должен быть в той же Wi-Fi сети, что и компьютер" Foreground="#B8BDC9" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <TextBlock Text="2. Наведи камеру телефона на код" Foreground="#B8BDC9" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <TextBlock Text="3. В Telegram нажми «Подключить прокси»" Foreground="#B8BDC9" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <Border x:Name="QrBox" Background="#FFFFFF" Padding="14" Width="250" Height="250" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform><ScaleTransform x:Name="QrBoxS"/></Border.RenderTransform>
                  <Grid>
                    <Viewbox Stretch="Uniform"><Path x:Name="QrPath" Fill="#000000"/></Viewbox>
                    <TextBlock x:Name="QrWait" Text="Готовлю…" Foreground="#5A6070" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="QrAddr" Foreground="{StaticResource Muted}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,10,0,12"/>
                <Button x:Name="QrCopy" Style="{StaticResource Btn}" Content="Скопировать ссылку" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- Уведомление -->
        <Grid x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" Opacity="0" IsHitTestVisible="False" MaxWidth="560">
          <Grid.RenderTransform><TranslateTransform x:Name="ToastShift" Y="30"/></Grid.RenderTransform>
          <!-- жёсткая пиксельная тень отдельным слоем: дешевле, чем эффект тени -->
          <Border Background="#99000000" Margin="5,5,-5,-5" IsHitTestVisible="False"/>
          <Border Background="#2A2E38" Padding="18,10">
            <TextBlock x:Name="ToastText" FontSize="13" TextWrapping="Wrap"/>
          </Border>
        </Grid>
      </Grid>
    </Border>
    </Grid>
  </Grid>
</Window>
